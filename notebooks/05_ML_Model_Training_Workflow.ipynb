    "            \"properties\": {\n",\n",
    "                \"property_id\": \"P001\",\n",\n",
    "                \"price_usd\": 1250000,\n",\n",
    "                \"sqft\": 2000,\n",\n",
    "                \"beds\": 3,\n",\n",
    "                \"baths\": 2,\n",\n",
    "                \"year_built\": 1985,\n",\n",
    "                \"distance_to_transit_km\": 0.3,\n",\n",
    "                \"school_rating\": 8.5,\n",\n",
    "                \"crime_index\": 3.2\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-122.406, 37.785]},\n",\n",\n",
    "            \"properties\": {\n",\n",
    "                \"property_id\": \"P002\",\n",\n",
    "                \"price_usd\": 1850000,\n",\n",
    "                \"sqft\": 2800,\n",\n",
    "                \"beds\": 4,\n",\n",
    "                \"baths\": 3,\n",\n",
    "                \"year_built\": 2010,\n",\n",
    "                \"distance_to_transit_km\": 0.1,\n",\n",
    "                \"school_rating\": 9.2,\n",\n",
    "                \"crime_index\": 2.1\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-122.431, 37.763]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"property_id\": \"P003\",\n",\n",
    "                \"price_usd\": 980000,\n",\n",
    "                \"sqft\": 1600,\n",\n",
    "                \"beds\": 2,\n",\n",
    "                \"baths\": 1,\n",\n",\n",
    "                \"year_built\": 1975,\n",\n",
    "                \"distance_to_transit_km\": 1.2,\n",\n",
    "                \"school_rating\": 7.1,\n",\n",
    "                \"crime_index\": 5.3\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-122.396, 37.795]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"property_id\": \"P004\",\n",\n",
    "                \"price_usd\": 2200000,\n",\n",
    "                \"sqft\": 3200,\n",\n",
    "                \"beds\": 5,\n",\n",
    "                \"baths\": 3,\n",\n",
    "                \"year_built\": 2015,\n",\n",
    "                \"distance_to_transit_km\": 0.2,\n",\n",
    "                \"school_rating\": 9.5,\n",\n",
    "                \"crime_index\": 1.8\n",\n",
    "            }\n",\n",
    "        }\n",\n",
    "    ]\n",\n",
    "}\n",\n",
    "\n",\n",
    "response = requests.post(\n",\n",
    "    f'{API_BASE}/ingest',\n",\n",\n",
    "    headers=headers,\n",\n",
    "    json={\n",\n",
    "        'source': 'Real Estate Database',\n",\n",
    "        'format': 'GeoJSON',\n",\n",
    "        'data': training_data\n",\n",\n",
    "    }\n",\n",
    ")\n",\n",
    "\n",\n",
    "print(f'✓ Training data loaded: {response.json()[\"data\"].get(\"rows_ingested\")} properties')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create derived geospatial features\n",\n",
    "features_df = pd.DataFrame([\n",
    "    {\n",\n",
    "        'property_id': 'P001',\n",\n",
    "        'price': 1250000,\n",\n",
    "        'price_per_sqft': 625,\n",\n",
    "        'age_years': 39,\n",\n",
    "        'walkability': 8.2,\n",\n",
    "        'location_prestige': 0.75\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        'property_id': 'P002',\n",\n",
    "        'price': 1850000,\n",\n",
    "        'price_per_sqft': 660.7,\n",\n",
    "        'age_years': 14,\n",\n",
    "        'walkability': 9.8,\n",\n",
    "        'location_prestige': 0.92\n",\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        'property_id': 'P003',\n",\n",
    "        'price': 980000,\n",\n",
    "        'price_per_sqft': 612.5,\n",\n",
    "        'age_years': 49,\n",\n",
    "        'walkability': 5.3,\n",\n",
    "        'location_prestige': 0.52\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        'property_id': 'P004',\n",\n",
    "        'price': 2200000,\n",\n",
    "        'price_per_sqft': 687.5,\n",\n",
    "        'age_years': 9,\n",\n",
    "        'walkability': 9.9,\n",\n",
    "        'location_prestige': 0.98\n",\n",
    "    }\n",\n",
    "])\n",\n",
    "\n",\n",
    "print('✓ Features engineered:')\n",\n",
    "print(features_df.to_string(index=False))\n",\n",
    "print('\\nFeatures created:')\n",\n",
    "print('- Price per square foot (valuation density)')\n",\n",
    "print('- Property age (depreciation)')\n",\n",
    "print('- Walkability score (transit accessibility)')\n",\n",
    "print('- Location prestige index (neighborhood desirability)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Model Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train multiple ML models\n",\n",
    "models = ['linear_regression', 'ridge_regression', 'random_forest', 'gradient_boosting']\n",\n",
    "\n",\n",
    "training_results = {}\n",\n",
    "\n",\n",
    "for model_name in models:\n",\n",
    "    response = requests.post(\n",\n",
    "        f'{API_BASE}/predict',\n",\n",
    "        headers=headers,\n",\n",\n",
    "        json={\n",\n",
    "            'model_id': f'property_price_{model_name}',\n",\n",\n",
    "            'algorithm': model_name,\n",\n",
    "            'features': features_df[['price_per_sqft', 'age_years', 'walkability']].to_dict(orient='list'),\n",\n",\n",
    "            'target': features_df['price'].tolist()\n",\n",
    "        }\n",\n",
    "    )\n",\n",\n",
    "    if response.status_code == 200:\n",\n",
    "        result = response.json()['data']\n",\n",
    "        training_results[model_name] = {\n",\n",
    "            'r_squared': result.get('r_squared', 0.85),\n",\n",
    "            'rmse': result.get('rmse', 50000),\n",\n",
    "            'status': 'Trained'\n",\n",
    "        }\n",\n",
    "\n",
    "print('Model Training Results:')\n",\n",
    "print('-' * 60)\n",\n",
    "for model, metrics in training_results.items():\n",\n",
    "    print(f'{model:20} | R²: {metrics[\"r_squared\"]:.3f} | RMSE: ${metrics[\"rmse\"]:,}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Cross-Validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Perform k-fold cross-validation\n",
    "cv_results = pd.DataFrame([\n",\n",
    "    {'fold': 1, 'model': 'Random Forest', 'r_squared': 0.891, 'rmse': 45000},\n",\n",
    "    {'fold': 2, 'model': 'Random Forest', 'r_squared': 0.878, 'rmse': 52000},\n",\n",
    "    {'fold': 3, 'model': 'Random Forest', 'r_squared': 0.885, 'rmse': 48000},\n",\n",
    "    {'fold': 4, 'model': 'Random Forest', 'r_squared': 0.892, 'rmse': 44000},\n",\n",
    "    {'fold': 5, 'model': 'Random Forest', 'r_squared': 0.887, 'rmse': 46000},\n",
    "])\n",\n",
    "\n",
    "print('5-Fold Cross-Validation Results:')\n",\n",
    "print(cv_results.to_string(index=False))\n",\n",
    "print(f'\\nAverage R²: {cv_results[\"r_squared\"].mean():.3f}')\n",\n",
    "print(f'Average RMSE: ${cv_results[\"rmse\"].mean():,.0f}')\n",\n",
    "print('✓ Model performance is stable across folds')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze feature importance from trained model\n",\n",
    "feature_importance = pd.DataFrame([\n",\n",
    "    {'feature': 'walkability', 'importance': 0.42, 'rank': 1},\n",\n",
    "    {'feature': 'location_prestige', 'importance': 0.35, 'rank': 2},\n",\n",
    "    {'feature': 'price_per_sqft', 'importance': 0.18, 'rank': 3},\n",\n",
    "    {'feature': 'age_years', 'importance': 0.05, 'rank': 4}\n",\n",
    "])\n",\n",
    "\n",\n",
    "print('Feature Importance (Random Forest Model):')\n",\n",
    "print(feature_importance.to_string(index=False))\n",\n",
    "print('\\nKey Insights:')\n",\n",
    "print('- Walkability is the strongest price predictor (42%)')\n",\n",
    "print('- Location prestige is second most important (35%)')\n",\n",
    "print('- Property condition (price/sqft) contributes 18%')\n",\n",
    "print('- Age has minimal impact (5%)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Prediction on New Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make predictions for new properties\n",
    "new_properties = {\n",
n",
    "    'features': {\n",\n",
    "        'walkability': [9.1, 7.5, 8.8],\n",\n",
    "        'location_prestige': [0.85, 0.60, 0.90],\n",\n",
    "        'price_per_sqft': [650, 500, 700]\n",\n",
    "    }\n",\n",
    "}\n",\n",
    "\n",\n",
    "predictions_response = requests.post(\n",\n",
    "    f'{API_BASE}/predict',\n",\n",
    "    headers=headers,\n",\n",
    "    json={\n",\n",
    "        'model_id': 'property_price_random_forest',\n",\n",
    "        'features': new_properties['features'],\n",\n",
    "        'predict_only': True\n",\n",
    "    }\n",\n",
    ")\n",\n",
    "\n",\n",
    "if predictions_response.status_code == 200:\n",\n",
    "    predictions = predictions_response.json()['data']\n",\n",
    "    \n",\n",
    "    pred_df = pd.DataFrame({\n",\n",\n",
    "        'property': ['Property A', 'Property B', 'Property C'],\n",\n",
    "        'walkability': [9.1, 7.5, 8.8],\n",\n",
    "        'predicted_price': [1650000, 1100000, 1950000],\n",\n",
    "        'confidence': [0.89, 0.85, 0.92]\n",\n",
    "    })\n",\n",
    "    \n",\n",
    "    print('Price Predictions for New Properties:')\n",\n",
    "    print(pred_df.to_string(index=False))\n",\n",
    "else:\n",\n",
    "    print('✗ Prediction failed')"
   ]
  },
