   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Disease Hotspot Detection and Analysis\n",\n",
    "\n",\n",
    "## Overview\n",
    "This notebook demonstrates epidemiological analysis using spatial statistics:\n",\n",
    "1. **Data Ingestion**: Load disease case data\n",\n",
    "2. **Hotspot Analysis**: Identify disease clusters using Getis-Ord statistics\n",\n",
    "3. **Risk Assessment**: Calculate disease risk by location\n",\n",
    "4. **Visualization**: Create heatmaps for public health planning\n",\n",
    "\n",\n",
    "## Use Case\n",\n",
    "Detect disease clusters and prioritize public health interventions"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import json\n",
    "import pandas as pd\n",\n",
    "import numpy as np\n",\n",
    "from datetime import datetime, timedelta\n",\n",
    "\n",\n",
    "# API Configuration\n",\n",
    "API_BASE = 'http://localhost:8080'\n",\n",
    "headers = {'Content-Type': 'application/json'}\n",\n",
    "\n",\n",
    "# Authenticate\n",\n",
    "auth = requests.post(\n",\n",
    "    f'{API_BASE}/auth/login',\n",\n",
    "    json={'username': 'admin', 'password': 'changeme'}\n",\n",
    ")\n",\n",
    "token = auth.json()['data']['token']\n",\n",
    "headers['Authorization'] = f'Bearer {token}'\n",\n",
    "\n",\n",
    "print('✓ Configuration complete')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Disease Case Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sample disease case data (e.g., flu cases reported in a city)\n",\n",
    "disease_data = {\n",\n",
    "    \"type\": \"FeatureCollection\",\n",\n",
    "    \"features\": [\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-74.006, 40.713]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"case_id\": \"NYC001\",\n",\n",
    "                \"disease\": \"Influenza\",\n",\n",
    "                \"cases_reported\": 25,\n",\n",
    "                \"population\": 50000,\n",\n",
    "                \"date_reported\": \"2026-04-12\",\n",\n",
    "                \"age_group\": \"20-30\"\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-73.935, 40.730]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"case_id\": \"NYC002\",\n",\n",
    "                \"disease\": \"Influenza\",\n",\n",
    "                \"cases_reported\": 42,\n",\n",
    "                \"population\": 55000,\n",\n",
    "                \"date_reported\": \"2026-04-12\",\n",\n",
    "                \"age_group\": \"30-40\"\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-73.880, 40.750]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"case_id\": \"NYC003\",\n",\n",
    "                \"disease\": \"Influenza\",\n",\n",
    "                \"cases_reported\": 38,\n",\n",
    "                \"population\": 60000,\n",\n",
    "                \"date_reported\": \"2026-04-12\",\n",\n",
    "                \"age_group\": \"40-50\"\n",\n",
    "            }\n",\n",
    "        },\n",\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-74.020, 40.650]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"case_id\": \"NYC004\",\n",\n",
    "                \"disease\": \"Influenza\",\n",\n",
    "                \"cases_reported\": 15,\n",\n",
    "                \"population\": 48000,\n",\n",
    "                \"date_reported\": \"2026-04-12\",\n",\n",
    "                \"age_group\": \"60+\"\n",\n",
    "            }\n",\n",
    "        },\n",
    "        {\n",\n",
    "            \"type\": \"Feature\",\n",\n",
    "            \"geometry\": {\"type\": \"Point\", \"coordinates\": [-73.950, 40.680]},\n",\n",
    "            \"properties\": {\n",\n",
    "                \"case_id\": \"NYC005\",\n",\n",
    "                \"disease\": \"Influenza\",\n",\n",
    "                \"cases_reported\": 33,\n",\n",
    "                \"population\": 52000,\n",\n",
    "                \"date_reported\": \"2026-04-12\",\n",\n",
    "                \"age_group\": \"0-20\"\n",\n",
    "            }\n",\n",
    "        }\n",\n",
    "    ]\n",\n",
    "}\n",\n",
    "\n",\n",
    "# Ingest disease data\n",\n",
    "response = requests.post(\n",\n",\n",
    "    f'{API_BASE}/ingest',\n",\n",
    "    headers=headers,\n",\n",
    "    json={\n",\n",
    "        'source': 'Public Health Department',\n",\n",
    "        'format': 'GeoJSON',\n",\n",
    "        'data': disease_data\n",\n",
    "    }\n",\n",
    ")\n",\n",
    "\n",\n",
    "print(f'✓ Disease data ingested: {response.json()[\"data\"].get(\"rows_ingested\")} locations')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Hotspot Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify disease hotspots using Getis-Ord statistic\n",
    "hotspot_response = requests.post(\n",\n",
    "    f'{API_BASE}/analyze',\n",\n",
    "    headers=headers,\n",\n",
    "    json={\n",\n",
    "        'operation': 'hotspot_analysis',\n",\n",
    "        'params': {\n",\n",
    "            'variable': 'cases_reported'\n",\n",
    "        }\n",\n",
    "    }\n",\n",
    ")\n",\n",
    "\n",\n",
    "if hotspot_response.status_code == 200:\n",\n",
    "    hotspots = hotspot_response.json()['data']\n",\n",
    "    print('✓ Hotspot analysis completed')\n",\n",
    "    print(f'  Hotspots identified: {hotspots.get(\"hotspot_count\", 0)}')\n",\n",
    "    print('  Statistical method: Getis-Ord Gi*')\n",\n",
    "    print('  Significance level: 95%')\n",\n",
    "else:\n",\n",
    "    print(f'✗ Hotspot analysis failed')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Risk Assessment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate disease incidence rates by location\n",\n",
    "risk_data = [\n",\n",
    "    {\n",\n",
    "        \"location\": \"Manhattan East\",\n",\n",
    "        \"cases\": 42,\n",\n",
    "        \"population\": 55000,\n",\n",
    "        \"incidence_rate\": 763.6,  # per 100,000\n",\n",
    "        \"risk_level\": \"HIGH\"\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        \"location\": \"Midtown\",\n",\n",
    "        \"cases\": 38,\n",\n",
    "        \"population\": 60000,\n",\n",
    "        \"incidence_rate\": 633.3,\n",\n",
    "        \"risk_level\": \"HIGH\"\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        \"location\": \"Lower East\",\n",\n",
    "        \"cases\": 25,\n",\n",
    "        \"population\": 50000,\n",\n",\n",
    "        \"incidence_rate\": 500.0,\n",\n",
    "        \"risk_level\": \"MEDIUM\"\n",\n",
    "    },\n",\n",
    "    {\n",\n",
    "        \"location\": \"Staten Island\",\n",\n",
    "        \"cases\": 15,\n",\n",
    "        \"population\": 48000,\n",\n",
    "        \"incidence_rate\": 312.5,\n",\n",
    "        \"risk_level\": \"LOW\"\n",\n",
    "    }\n",\n",
    "]\n",\n",
    "\n",\n",
    "df_risk = pd.DataFrame(risk_data)\n",\n",
    "print('Disease Risk Assessment:')\n",\n",
    "print(df_risk.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Heatmap Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create disease heatmap\n",\n",
    "viz_response = requests.post(\n",\n",\n",
    "    f'{API_BASE}/visualize',\n",\n",
    "    headers=headers,\n",\n",
    "    json={\n",\n",
    "        'type': 'heatmap',\n",\n",
    "        'variable': 'cases_reported',\n",\n",\n",
    "        'colormap': 'YlOrRd',\n",\n",
    "        'title': 'Influenza Hotspot Map - NYC'\n",\n",
    "    }\n",\n",
    ")\n",\n",
    "\n",\n",
    "if viz_response.status_code == 200:\n",\n",
    "    print('✓ Heatmap visualization created')\n",\n",
    "    print('  Red areas indicate high disease concentration')\n",\n",
    "    print('  Yellow areas indicate lower case counts')\n",\n",
    "else:\n",\n",
    "    print(f'✗ Visualization failed')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Public Health Recommendations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "recommendations = {\n",
