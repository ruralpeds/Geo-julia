   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Time Series Monitoring"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Monitor disease trends over time\n",\n",
    "dates = pd.date_range('2026-04-01', periods=12, freq='D')\n",\n",
    "trends = {\n",\n",
    "    'date': dates.strftime('%Y-%m-%d').tolist(),\n",\n",
    "    'cases': [12, 15, 18, 22, 28, 35, 42, 45, 43, 40, 35, 30],\n",\n",
    "    'growth_rate': [0, 25, 20, 22, 27, 25, 20, 7, -4, -7, -12, -14]\n",\n",
    "}\n",\n",
    "\n",\n",
    "df_trends = pd.DataFrame(trends)\n",
    "print('Disease Trend Analysis:')\n",\n",
    "print(df_trends.to_string(index=False))\n",\n",
    "print(f'\\nPeak cases on: 2026-04-08 ({trends[\"cases\"][7]} cases)')\n",\n",
    "print('Current status: Declining')"
   ]
  },
  {
